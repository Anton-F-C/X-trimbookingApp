{
  "expo": {
    "name": "X-Trim-Lee",
    "slug": "X-Trim-Lee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logos/logo.png",
    "scheme": "xtrimlee",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/logos/logo.png"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/logos/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.acouncil42.XTrimLee"
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/logos/logo.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/logos/logo.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "c5fa2157-243d-4885-8de0-7fb848732c2f"
      }
    }
  }
}